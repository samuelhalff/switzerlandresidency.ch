# switzerlandresidency.ch — static export (Next.js `out/`) on Apache shared hosting.
# Subdirectories with their own .htaccess (e.g. the deny-all archive folder) keep their rules;
# nothing below rewrites anything except the bare root "/".

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType text/plain .txt
AddType application/xml .xml
AddType image/webp .webp

# ---------------------------------------------------------------------------
# "/" → best language by Accept-Language (primary language only), else /en/
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:Accept-Language} ^\s*fr [NC]
  RewriteRule ^$ /fr/ [R=302,L]

  RewriteCond %{HTTP:Accept-Language} ^\s*de [NC]
  RewriteRule ^$ /de/ [R=302,L]

  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # The root redirect depends on the browser language.
  Header always merge Vary "Accept-Language" "expr=%{REQUEST_URI} == '/'"

  # Static export needs inline bootstrap scripts, hence 'unsafe-inline' (no 'unsafe-eval').
  # Revisit with script hashes later (docs/PLAN.md, Codex review resolutions).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://api.formspark.io https://submit-form.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://submit-form.com https://api.formspark.io"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Frame-Options "DENY"

  # HSTS: enable ONLY once HTTPS works on every host name (AutoSSL or Cloudflare), then uncomment.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Caching: hashed build assets are immutable; HTML must revalidate so deploys show up at once.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    <FilesMatch "\.(html|txt|xml)$">
      Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|woff2?)$">
      Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
